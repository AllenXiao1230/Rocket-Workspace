# Public application address; change to your domain in production.
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://rocket:rocket@postgres:5432/rocket_workspace?schema=public
# Markdown documents are stored in workspace-data/documents within this project.
# Docker Compose supplies the matching container path automatically.
WORKSPACE_CONTENT_DIR=workspace-data

# First administrator created by `pnpm db:seed`.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-first-start
BOOTSTRAP_ADMIN_NAME=Workspace Admin

# Browser accesses this URL; use wss:// behind TLS in production.
NEXT_PUBLIC_COLLABORATION_URL=ws://localhost:1234
COLLABORATION_PORT=1234
# Short-lived, document-scoped collaboration token. Existing sockets close at expiry.
COLLABORATION_TOKEN_TTL=10m
# Comma-separated browser origins permitted to open collaboration sockets.
COLLABORATION_ALLOWED_ORIGINS=http://localhost:3000

REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=attachments
MINIO_USE_SSL=false
# Maximum attachment size accepted by the web app, in bytes (10 MiB by default).
MAX_ATTACHMENT_BYTES=10485760
# Optional comma-separated allow-list, for example: application/pdf,image/png,image/jpeg
ALLOWED_ATTACHMENT_MIME_TYPES=

# Backup runs once when the service starts, then at this interval.
# Backups contain PostgreSQL, workspace Markdown files, and MinIO attachments.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# Security feature defaults; owners and administrators can change these in 設定中心.
COLLABORATION_ENABLED=true
ATTACHMENTS_ENABLED=true
MARKDOWN_DOWNLOAD_ENABLED=true
ACCOUNT_PROVISIONING_ENABLED=true
FORCE_PASSWORD_CHANGE_ON_NEW_ACCOUNT=true
MINIMUM_PASSWORD_LENGTH=12
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
