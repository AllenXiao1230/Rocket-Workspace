# Public application address; change to your domain in production.
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://rocket:rocket@postgres:5432/rocket_workspace?schema=public
# Markdown documents are stored in workspace-data/documents within this project.
# Docker Compose supplies the matching container path automatically.
WORKSPACE_CONTENT_DIR=workspace-data

# First administrator created by `pnpm db:seed`.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-first-start
BOOTSTRAP_ADMIN_NAME=Workspace Admin

# Browser accesses this URL; use wss:// behind TLS in production.
NEXT_PUBLIC_COLLABORATION_URL=ws://localhost:1234
COLLABORATION_PORT=1234
# Short-lived, document-scoped collaboration token. Existing sockets close at expiry.
COLLABORATION_TOKEN_TTL=10m
# Comma-separated browser origins permitted to open collaboration sockets.
COLLABORATION_ALLOWED_ORIGINS=http://localhost:3000
# Redis shares updates and awareness between collaboration containers. Keep this
# enabled when using more than one collab replica behind a WebSocket proxy.
COLLABORATION_REDIS_ENABLED=true
COLLABORATION_REDIS_STREAM_MAXLEN=10000
COLLABORATION_INSTANCE_ID=

REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=attachments
MINIO_USE_SSL=false
# Maximum attachment size accepted by the web app, in bytes (10 MiB by default).
MAX_ATTACHMENT_BYTES=10485760
# Optional comma-separated allow-list, for example: application/pdf,image/png,image/jpeg
ALLOWED_ATTACHMENT_MIME_TYPES=

# Backup runs once when the service starts, then at this interval.
# Backups contain PostgreSQL, workspace Markdown files, and MinIO attachments.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
# Readiness fails when no successful backup is newer than this many hours.
BACKUP_MAX_AGE_HOURS=48

# Security feature defaults; owners and administrators can change these in 設定中心.
COLLABORATION_ENABLED=true
ATTACHMENTS_ENABLED=true
MARKDOWN_DOWNLOAD_ENABLED=true
ACCOUNT_PROVISIONING_ENABLED=false
FORCE_PASSWORD_CHANGE_ON_NEW_ACCOUNT=false
MINIMUM_PASSWORD_LENGTH=12
LOGIN_RATE_LIMIT_ENABLED=false
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# AI and external integrations are disabled by default. Configure them from
# 設定中心; secrets are encrypted in PostgreSQL and are never shown again.
# Optional: a separate 32+ character key for those encrypted settings. When
# blank, AUTH_SECRET is used. Do not commit an actual value.
WORKSPACE_SETTINGS_ENCRYPTION_KEY=
# The only internal plain-HTTP Ollama hostname allowed by default is "ollama".
# Add comma-separated hostnames only when they are trusted Docker services.
OLLAMA_ALLOWED_HOSTS=ollama
AI_ENABLED=false
AI_PROVIDER=OPENAI_COMPATIBLE
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
GITHUB_INTEGRATION_ENABLED=false
GITHUB_REPOSITORY=
GITHUB_TOKEN=
WEBHOOK_INTEGRATION_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=

# Optional update-check settings. APP_COMMIT and APP_VERSION are injected by
# scripts/deploy-from-github.sh; set them manually only for manual deployments.
UPDATE_REPOSITORY=AllenXiao1230/Rocket-Workspace
UPDATE_GITHUB_TOKEN=
APP_COMMIT=
APP_VERSION=
