#!/usr/bin/env bash

set -Eeuo pipefail

# Empty commits should not create a version-only change.  Every real commit
# receives exactly one patch-version increment, then stages it automatically.
if git diff --cached --quiet; then
  exit 0
fi

repo_dir="$(git rev-parse --show-toplevel)"
"$repo_dir/scripts/bump-version.sh"
git add "$repo_dir/package.json"
