generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum IssueStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  WONT_FIX
}

enum TestOutcome {
  PLANNED
  PASS
  FAIL
  BLOCKED
}

enum DatabasePropertyType {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  STATUS
  DATE
  PERSON
  FILES
  CHECKBOX
  URL
  EMAIL
  PHONE
  RELATION
  ROLLUP
  FORMULA
  UNIQUE_ID
  CREATED_TIME
  UPDATED_TIME
}

enum DatabaseViewLayout {
  TABLE
  BOARD
  CALENDAR
  TIMELINE
  GALLERY
  LIST
  FORM
}

enum AutomationTrigger {
  ROW_CREATED
  ROW_UPDATED
}

enum AutomationAction {
  SET_PROPERTY
  CREATE_ROW
  NOTIFY
}

enum DatabaseImportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  ROLLED_BACK
}

enum DocumentReviewState {
  DRAFT
  IN_REVIEW
  APPROVED
  CHANGES_REQUESTED
}

enum DocumentSyncAction {
  WRITE
  DELETE
}

enum AttachmentSyncAction {
  UPLOAD
  DELETE
}

enum AttachmentSyncStatus {
  PENDING
  READY
  FAILED
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum PurchaseStatus {
  NOT_REQUIRED
  PLANNED
  REQUESTED
  ORDERED
  RECEIVED
  CANCELLED
}

enum TestStepStatus {
  PENDING
  PASS
  FAIL
  BLOCKED
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String
  avatarEmoji        String?
  avatarKey          String?
  passwordHash       String
  mustChangePassword Boolean             @default(false)
  isSystemAdmin      Boolean             @default(false)
  createdAt          DateTime            @default(now())
  memberships        Membership[]
  tasks              Task[]              @relation("Assignee")
  auditEvents        AuditEvent[]
  comments           DocumentComment[]
  revisions          DocumentRevision[]
  lockedDocuments    Document[]          @relation("DocumentLock")
  reviewedDocuments  Document[]          @relation("DocumentReviewer")
  workLogs           TaskWorkLog[]
  testApprovals      TestApproval[]
  notifications      Notification[]
  databaseImportJobs DatabaseImportJob[]
}

model Workspace {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  createdAt   DateTime           @default(now())
  memberships Membership[]
  projects    Project[]
  settings    WorkspaceSettings?
}

model WorkspaceSettings {
  workspaceId      String    @id
  security         Json      @default("{}")
  ai               Json      @default("{}")
  integrations     Json      @default("{}")
  encryptedSecrets String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Membership {
  id          String        @id @default(cuid())
  role        WorkspaceRole @default(VIEWER)
  nickname    String?
  teamGroup   String?
  jobTitle    String?
  userId      String
  workspaceId String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

model Project {
  id                String             @id @default(cuid())
  name              String
  code              String
  description       String?
  workspaceId       String
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents         Document[]
  tasks             Task[]
  issues            Issue[]
  bomItems          BomItem[]
  testRecords       TestRecord[]
  databases         Database[]
  documentTemplates DocumentTemplate[]
  taskTemplates     TaskTemplate[]
  testPlans         TestPlan[]
  requirements      Requirement[]
  calendarFeed      CalendarFeed?
  workingDays       Json               @default("[1,2,3,4,5]")
  holidayDates      Json               @default("[]")
  createdAt         DateTime           @default(now())

  @@unique([workspaceId, code])
}

// A per-project bearer token for the read-only iCalendar subscription. The
// token itself is never stored: only its SHA-256 digest is kept in PostgreSQL.
model CalendarFeed {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Database {
  id               String               @id @default(cuid())
  name             String
  icon             String               @default("▦")
  projectId        String
  parentDocumentId String?
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentDocument   Document?            @relation("DocumentDatabases", fields: [parentDocumentId], references: [id], onDelete: SetNull)
  properties       DatabaseProperty[]
  views            DatabaseView[]
  rows             DatabaseRow[]
  templates        DatabaseTemplate[]
  automations      DatabaseAutomation[]
  importJobs       DatabaseImportJob[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([projectId, createdAt])
  @@index([parentDocumentId])
}

model DatabaseImportJob {
  id            String               @id @default(cuid())
  status        DatabaseImportStatus @default(PENDING)
  inputRows     Json
  errorRows     Json?
  totalRows     Int
  processedRows Int                  @default(0)
  createdRows   Int                  @default(0)
  databaseId    String
  userId        String
  database      Database             @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([databaseId, status, createdAt])
  @@index([userId, createdAt])
}

model DatabaseProperty {
  id              String               @id @default(cuid())
  name            String
  type            DatabasePropertyType @default(TEXT)
  options         Json?
  position        Int                  @default(0)
  deletedAt       DateTime?
  deletionBatchId String?
  databaseId      String
  database        Database             @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([databaseId, position])
  @@index([databaseId, deletedAt])
  @@index([deletionBatchId])
}

model DatabaseView {
  id         String             @id @default(cuid())
  name       String
  layout     DatabaseViewLayout @default(TABLE)
  config     Json?
  filter     Json?
  sort       Json?
  position   Int                @default(0)
  databaseId String
  database   Database           @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([databaseId, position])
}

model DatabaseTemplate {
  id         String   @id @default(cuid())
  name       String
  values     Json     @default("{}")
  databaseId String
  database   Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([databaseId, name])
}

model DatabaseAutomation {
  id         String            @id @default(cuid())
  name       String
  trigger    AutomationTrigger
  action     AutomationAction
  config     Json              @default("{}")
  enabled    Boolean           @default(true)
  databaseId String
  database   Database          @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([databaseId, enabled])
}

model DatabaseRow {
  id              String    @id @default(cuid())
  values          Json      @default("{}")
  position        Int       @default(0)
  deletedAt       DateTime?
  deletionBatchId String?
  importJobId     String?
  databaseId      String
  database        Database  @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([databaseId, position])
  @@index([databaseId, deletedAt])
  @@index([deletionBatchId])
  @@index([importJobId])
}

model Document {
  id                String              @id @default(cuid())
  title             String
  icon              String              @default("📄")
  content           Json                @default("{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]}")
  position          Int                 @default(0)
  projectId         String
  parentId          String?
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent            Document?           @relation("DocumentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          Document[]          @relation("DocumentTree")
  databases         Database[]          @relation("DocumentDatabases")
  deletedAt         DateTime?
  deletionBatchId   String?
  markdownHash      String?
  markdownBase      String?
  properties        Json                @default("{}")
  reviewState       DocumentReviewState @default(DRAFT)
  reviewRequestedAt DateTime?
  reviewedAt        DateTime?
  lockedAt          DateTime?
  lockedById        String?
  reviewerId        String?
  lockedBy          User?               @relation("DocumentLock", fields: [lockedById], references: [id], onDelete: SetNull)
  reviewer          User?               @relation("DocumentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  updatedAt         DateTime            @updatedAt
  createdAt         DateTime            @default(now())
  attachments       Attachment[]
  comments          DocumentComment[]
  revisions         DocumentRevision[]
  syncJob           DocumentSyncJob?

  @@index([projectId, parentId, position])
  @@index([projectId, deletedAt])
  @@index([deletionBatchId])
  @@index([projectId, reviewState])
  @@index([lockedById])
}

// Durable outbox for the filesystem mirror. The database transaction commits
// first; a worker retries the side effect until it has completed.
model DocumentSyncJob {
  id         String             @id @default(cuid())
  documentId String             @unique
  action     DocumentSyncAction @default(WRITE)
  markdown   String?
  attempts   Int                @default(0)
  lastError  String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  document   Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model DocumentTemplate {
  id         String   @id @default(cuid())
  name       String
  icon       String   @default("📄")
  content    Json     @default("{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]}")
  markdown   String?
  properties Json     @default("{}")
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, name])
}

model DocumentComment {
  id         String            @id @default(cuid())
  body       String
  resolvedAt DateTime?
  documentId String
  authorId   String
  parentId   String?
  document   Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author     User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent     DocumentComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    DocumentComment[] @relation("CommentThread")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([documentId, resolvedAt, createdAt])
}

model DocumentRevision {
  id         String   @id @default(cuid())
  title      String
  content    Json
  markdown   String?
  documentId String
  authorId   String?
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt])
}

model Notification {
  id               String    @id @default(cuid())
  title            String
  body             String?
  href             String?
  deduplicationKey String?   @unique
  readAt           DateTime?
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model Task {
  id                    String           @id @default(cuid())
  title                 String
  status                TaskStatus       @default(TODO)
  priority              Int              @default(2)
  startDate             DateTime?
  dueDate               DateTime?
  baselineStartDate     DateTime?
  baselineDueDate       DateTime?
  estimatedHours        Float?
  projectId             String
  assigneeId            String?
  deletedAt             DateTime?
  deletionBatchId       String?
  project               Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee              User?            @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dependencies          TaskDependency[] @relation("TaskDependencies")
  dependents            TaskDependency[] @relation("TaskDependents")
  parentId              String?
  parent                Task?            @relation("TaskTree", fields: [parentId], references: [id], onDelete: SetNull)
  children              Task[]           @relation("TaskTree")
  milestone             Boolean          @default(false)
  recurrenceRule        String?
  recurrenceAnchor      DateTime?
  recurrenceSourceId    String?
  recurrenceProcessedAt DateTime?
  slaDueAt              DateTime?
  workLogs              TaskWorkLog[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([recurrenceSourceId, recurrenceAnchor])
  @@index([projectId, status])
  @@index([projectId, deletedAt])
  @@index([deletionBatchId])
  @@index([projectId, parentId])
  @@index([projectId, slaDueAt])
  @@index([recurrenceSourceId])
  @@index([projectId, status, recurrenceProcessedAt])
}

model TaskWorkLog {
  id        String   @id @default(cuid())
  minutes   Int
  note      String?
  workDate  DateTime @default(now())
  taskId    String
  userId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([taskId, workDate])
  @@index([userId, workDate])
}

model TaskTemplate {
  id        String   @id @default(cuid())
  name      String
  values    Json     @default("{}")
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
}

model TaskDependency {
  id          String   @id @default(cuid())
  taskId      String
  dependsOnId String
  task        Task     @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task     @relation("TaskDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([taskId, dependsOnId])
  @@index([dependsOnId])
}

model Issue {
  id              String      @id @default(cuid())
  key             String
  title           String
  status          IssueStatus @default(OPEN)
  severity        Int         @default(2)
  projectId       String
  deletedAt       DateTime?
  deletionBatchId String?
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([projectId, key])
  @@index([projectId, deletedAt])
  @@index([deletionBatchId])
}

model BomItem {
  id                 String         @id @default(cuid())
  partNumber         String
  name               String
  quantity           Int            @default(1)
  unitCost           Decimal?       @db.Decimal(12, 2)
  supplier           String?
  status             String         @default("PLANNED")
  supplierPartNumber String?
  alternatives       Json           @default("[]")
  inventoryQuantity  Int            @default(0)
  reorderPoint       Int?
  currency           String         @default("TWD")
  version            String?
  approvalStatus     ApprovalStatus @default(DRAFT)
  purchaseStatus     PurchaseStatus @default(NOT_REQUIRED)
  leadTimeDays       Int?
  riskLevel          Int            @default(1)
  notes              String?
  attachments        Attachment[]   @relation("BomAttachments")
  projectId          String
  deletedAt          DateTime?
  deletionBatchId    String?
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([projectId, partNumber])
  @@index([projectId, deletedAt])
  @@index([deletionBatchId])
  @@index([projectId, purchaseStatus])
}

model TestRecord {
  id              String                    @id @default(cuid())
  title           String
  outcome         TestOutcome               @default(PLANNED)
  testDate        DateTime?
  operator        String?
  notes           String?
  planId          String?
  plan            TestPlan?                 @relation(fields: [planId], references: [id], onDelete: SetNull)
  steps           TestStep[]
  measurements    TestMeasurement[]
  approvals       TestApproval[]
  requirements    RequirementVerification[]
  attachments     Attachment[]              @relation("TestAttachments")
  projectId       String
  deletedAt       DateTime?
  deletionBatchId String?
  project         Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([projectId, outcome])
  @@index([projectId, deletedAt])
  @@index([deletionBatchId])
  @@index([planId])
}

model TestPlan {
  id             String         @id @default(cuid())
  title          String
  objective      String?
  version        String?
  approvalStatus ApprovalStatus @default(DRAFT)
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  records        TestRecord[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([projectId, approvalStatus])
}

model TestStep {
  id           String         @id @default(cuid())
  position     Int            @default(0)
  instruction  String
  expected     String?
  actual       String?
  status       TestStepStatus @default(PENDING)
  testRecordId String
  testRecord   TestRecord     @relation(fields: [testRecordId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([testRecordId, position])
}

model TestMeasurement {
  id           String     @id @default(cuid())
  name         String
  value        Float
  unit         String?
  minimum      Float?
  maximum      Float?
  testRecordId String
  testRecord   TestRecord @relation(fields: [testRecordId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([testRecordId])
}

model TestApproval {
  id           String         @id @default(cuid())
  status       ApprovalStatus @default(PENDING)
  note         String?
  testRecordId String
  reviewerId   String
  testRecord   TestRecord     @relation(fields: [testRecordId], references: [id], onDelete: Cascade)
  reviewer     User           @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([testRecordId, status])
}

model Requirement {
  id            String                    @id @default(cuid())
  key           String
  title         String
  description   String?
  projectId     String
  project       Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  verifications RequirementVerification[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@unique([projectId, key])
}

model RequirementVerification {
  id            String      @id @default(cuid())
  requirementId String
  testRecordId  String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  testRecord    TestRecord  @relation(fields: [testRecordId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([requirementId, testRecordId])
  @@index([testRecordId])
}

model Attachment {
  id              String               @id @default(cuid())
  filename        String
  mimeType        String
  size            Int
  storageKey      String               @unique
  documentId      String?
  document        Document?            @relation(fields: [documentId], references: [id], onDelete: SetNull)
  bomItemId       String?
  bomItem         BomItem?             @relation("BomAttachments", fields: [bomItemId], references: [id], onDelete: SetNull)
  testRecordId    String?
  testRecord      TestRecord?          @relation("TestAttachments", fields: [testRecordId], references: [id], onDelete: SetNull)
  deletedAt       DateTime?
  deletionBatchId String?
  syncStatus      AttachmentSyncStatus @default(PENDING)
  syncError       String?
  syncJob         AttachmentSyncJob?
  createdAt       DateTime             @default(now())

  @@index([documentId, deletedAt])
  @@index([deletionBatchId])
  @@index([bomItemId, deletedAt])
  @@index([testRecordId, deletedAt])
}

model AttachmentSyncJob {
  id           String               @id @default(cuid())
  action       AttachmentSyncAction
  payload      Bytes?
  attempts     Int                  @default(0)
  lastError    String?
  attachmentId String               @unique
  attachment   Attachment           @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([createdAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  action      String
  entity      String
  entityId    String
  metadata    Json?
  workspaceId String?
  projectId   String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
}
