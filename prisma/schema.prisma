generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum IssueStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  WONT_FIX
}

enum TestOutcome {
  PLANNED
  PASS
  FAIL
  BLOCKED
}

enum DatabasePropertyType {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  STATUS
  DATE
  PERSON
  FILES
  CHECKBOX
  URL
  EMAIL
  PHONE
  RELATION
  ROLLUP
  FORMULA
  UNIQUE_ID
  CREATED_TIME
  UPDATED_TIME
}

enum DatabaseViewLayout {
  TABLE
  BOARD
  CALENDAR
  TIMELINE
  GALLERY
  LIST
  FORM
}

enum AutomationTrigger {
  ROW_CREATED
  ROW_UPDATED
}

enum AutomationAction {
  SET_PROPERTY
  CREATE_ROW
  NOTIFY
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  avatarEmoji  String?
  passwordHash String
  mustChangePassword Boolean @default(false)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  tasks        Task[]       @relation("Assignee")
  auditEvents  AuditEvent[]
  comments     DocumentComment[]
  revisions    DocumentRevision[]
  notifications Notification[]
}

model Workspace {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  memberships Membership[]
  projects    Project[]
}

model Membership {
  id          String        @id @default(cuid())
  role        WorkspaceRole @default(VIEWER)
  nickname    String?
  teamGroup   String?
  jobTitle    String?
  userId      String
  workspaceId String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

model Project {
  id          String       @id @default(cuid())
  name        String
  code        String
  description String?
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents   Document[]
  tasks       Task[]
  issues      Issue[]
  bomItems    BomItem[]
  testRecords TestRecord[]
  databases   Database[]
  createdAt   DateTime     @default(now())
  @@unique([workspaceId, code])
}

model Database {
  id         String             @id @default(cuid())
  name       String
  icon       String             @default("▦")
  projectId  String
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  properties DatabaseProperty[]
  views      DatabaseView[]
  rows       DatabaseRow[]
  templates  DatabaseTemplate[]
  automations DatabaseAutomation[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  @@index([projectId, createdAt])
}

model DatabaseProperty {
  id         String               @id @default(cuid())
  name       String
  type       DatabasePropertyType @default(TEXT)
  options    Json?
  position   Int                  @default(0)
  databaseId String
  database   Database             @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  @@index([databaseId, position])
}

model DatabaseView {
  id         String   @id @default(cuid())
  name       String
  layout     DatabaseViewLayout @default(TABLE)
  config     Json?
  filter     Json?
  sort       Json?
  position   Int      @default(0)
  databaseId String
  database   Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([databaseId, position])
}

model DatabaseTemplate {
  id         String   @id @default(cuid())
  name       String
  values     Json     @default("{}")
  databaseId String
  database   Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([databaseId, name])
}

model DatabaseAutomation {
  id         String           @id @default(cuid())
  name       String
  trigger    AutomationTrigger
  action     AutomationAction
  config     Json             @default("{}")
  enabled    Boolean          @default(true)
  databaseId String
  database   Database         @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  @@index([databaseId, enabled])
}

model DatabaseRow {
  id         String   @id @default(cuid())
  values     Json     @default("{}")
  position   Int      @default(0)
  deletedAt  DateTime?
  deletionBatchId String?
  databaseId String
  database   Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([databaseId, position])
  @@index([databaseId, deletedAt])
  @@index([deletionBatchId])
}

model Document {
  id        String     @id @default(cuid())
  title     String
  icon      String     @default("📄")
  content   Json       @default("{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]}")
  position  Int        @default(0)
  projectId String
  parentId  String?
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Document?  @relation("DocumentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Document[] @relation("DocumentTree")
  deletedAt DateTime?
  deletionBatchId String?
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
  attachments Attachment[]
  comments    DocumentComment[]
  revisions   DocumentRevision[]
  @@index([projectId, parentId, position])
  @@index([projectId, deletedAt])
  @@index([deletionBatchId])
}

model DocumentComment {
  id         String   @id @default(cuid())
  body       String
  resolvedAt DateTime?
  documentId String
  authorId   String
  parentId   String?
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent     DocumentComment? @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    DocumentComment[] @relation("CommentThread")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([documentId, resolvedAt, createdAt])
}

model DocumentRevision {
  id         String   @id @default(cuid())
  title      String
  content    Json
  markdown   String?
  documentId String
  authorId   String?
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  @@index([documentId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, readAt, createdAt])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  status      TaskStatus @default(TODO)
  priority    Int        @default(2)
  startDate   DateTime?
  dueDate     DateTime?
  projectId   String
  assigneeId  String?
  deletedAt   DateTime?
  deletionBatchId String?
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?      @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dependencies TaskDependency[] @relation("TaskDependencies")
  dependents   TaskDependency[] @relation("TaskDependents")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  @@index([projectId, status])
  @@index([projectId, deletedAt])
  @@index([deletionBatchId])
}

model TaskDependency {
  id          String   @id @default(cuid())
  taskId      String
  dependsOnId String
  task        Task     @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task     @relation("TaskDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([taskId, dependsOnId])
  @@index([dependsOnId])
}

model Issue {
  id          String      @id @default(cuid())
  key         String
  title       String
  status      IssueStatus @default(OPEN)
  severity    Int         @default(2)
  projectId   String
  deletedAt   DateTime?
  deletionBatchId String?
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  @@unique([projectId, key])
  @@index([projectId, deletedAt])
  @@index([deletionBatchId])
}

model BomItem {
  id          String   @id @default(cuid())
  partNumber  String
  name        String
  quantity    Int      @default(1)
  unitCost    Decimal? @db.Decimal(12, 2)
  supplier    String?
  status      String   @default("PLANNED")
  projectId   String
  deletedAt   DateTime?
  deletionBatchId String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([projectId, partNumber])
  @@index([projectId, deletedAt])
  @@index([deletionBatchId])
}

model TestRecord {
  id          String      @id @default(cuid())
  title       String
  outcome     TestOutcome @default(PLANNED)
  testDate    DateTime?
  operator    String?
  notes       String?
  projectId   String
  deletedAt   DateTime?
  deletionBatchId String?
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  @@index([projectId, outcome])
  @@index([projectId, deletedAt])
  @@index([deletionBatchId])
}

model Attachment {
  id         String   @id @default(cuid())
  filename   String
  mimeType   String
  size       Int
  storageKey String   @unique
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

model AuditEvent {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  metadata  Json?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([entity, entityId, createdAt])
}
