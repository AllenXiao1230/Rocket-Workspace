{
  "name": "rocket-workspace",
  "version": "0.1.43",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:integration:prepare": "node scripts/prepare-integration-db.mjs",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "documents:sync": "tsx scripts/sync-markdown.ts",
    "version:bump": "bash scripts/bump-version.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "collab": "node apps/collab-server/index.mjs",
    "scheduler": "tsx scripts/task-scheduler.ts",
    "loadtest:collab": "node scripts/collab-loadtest.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.799.0",
    "@prisma/client": "^6.8.2",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-collaboration": "^3.0.7",
    "@tiptap/extension-collaboration-caret": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.0.7",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-table-cell": "^3.29.2",
    "@tiptap/extension-table-header": "^3.29.2",
    "@tiptap/extension-table-row": "^3.29.2",
    "@tiptap/extension-task-item": "^3.29.2",
    "@tiptap/extension-task-list": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/markdown": "^3.29.2",
    "@tiptap/react": "^3.0.7",
    "@tiptap/starter-kit": "^3.0.7",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.10",
    "next": "^15.3.3",
    "next-auth": "^5.0.0-beta.29",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "redis": "^4.7.0",
    "ws": "^8.18.2",
    "y-indexeddb": "^9.0.12",
    "y-leveldb": "^0.1.2",
    "y-protocols": "^1.0.7",
    "y-websocket": "^2.1.0",
    "yjs": "^13.6.27",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/ws": "^8.5.14",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
